<script>
  // Tab switching
  document.querySelectorAll('.tab-btn').forEach(btn => {
    btn.addEventListener('click', () => {
      document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
      document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
      btn.classList.add('active');
      document.getElementById('tab-' + btn.dataset.tab).classList.add('active');
    });
  });

  // ===== POT ODDS =====
  function calcPotOdds() {
    const pot = parseFloat(document.getElementById('po-pot').value);
    const bet = parseFloat(document.getElementById('po-bet').value);
    if (!pot || !bet || bet <= 0) return;
    const totalPot = pot + bet;
    const required = bet / (totalPot + bet);
    const ratio = (totalPot / bet);
    document.getElementById('po-ratio').textContent = ratio.toFixed(2) + ' : 1';
    document.getElementById('po-pct').textContent = (required * 100).toFixed(1) + '%';
    document.getElementById('po-required').textContent = (required * 100).toFixed(1) + '%';
    document.getElementById('po-explain').textContent = 'Need ' + (required * 100).toFixed(1) + '% to break even';
  }

  // ===== OUTS TO EQUITY =====
  function calcOuts() {
    const outs = parseInt(document.getElementById('outs-count').value);
    const streets = parseInt(document.getElementById('outs-street').value);
    if (isNaN(outs) || outs < 0 || outs > 47) return;
    // Rule of 2/4 approximation
    const approx = outs * (streets === 2 ? 4 : 2);
    // Exact: 1 - C(47-outs, streets) / C(47, streets) for 2 streets, or outs/46 for one
    let exact;
    let formula;
    if (streets === 1) {
      exact = (outs / 46) * 100;
      formula = outs + ' of 46 unseen cards';
    } else {
      // P(hit by river) = 1 - P(miss turn)*P(miss river)
      // Approximation: 1 - ((47-outs)/47) * ((46-outs)/46)
      const missBoth = ((47 - outs) / 47) * ((46 - outs) / 46);
      exact = (1 - missBoth) * 100;
      formula = outs + ' outs · two streets';
    }
    document.getElementById('outs-equity').textContent = approx.toFixed(1) + '%';
    document.getElementById('outs-rule').textContent = streets === 2 ? 'Rule of 4: outs × 4' : 'Rule of 2: outs × 2';
    document.getElementById('outs-exact').textContent = exact.toFixed(1) + '%';
    document.getElementById('outs-formula').textContent = formula;
  }

  // ===== ROI =====
  function calcROI() {
    const played = parseInt(document.getElementById('roi-played').value);
    const buyin = parseFloat(document.getElementById('roi-buyin').value);
    const cashes = parseFloat(document.getElementById('roi-cashes').value);
    if (!played || !buyin || isNaN(cashes)) return;
    const totalSpent = played * buyin;
    const profit = cashes - totalSpent;
    const roi = (profit / totalSpent) * 100;
    document.getElementById('roi-pct').textContent = roi.toFixed(1) + '%';
    document.getElementById('roi-status').textContent = profit > 0 ? 'Profitable' : profit < 0 ? 'Losing player' : 'Breakeven';
    document.getElementById('roi-profit').textContent = '₱' + profit.toLocaleString('en-PH', {maximumFractionDigits: 0});
    document.getElementById('roi-perTourney').textContent = '₱' + (profit / played).toLocaleString('en-PH', {maximumFractionDigits: 0}) + ' per tournament';
  }

  // ===== BANKROLL =====
  function calcBankroll() {
    const wr = parseFloat(document.getElementById('br-winrate').value);
    const sd = parseFloat(document.getElementById('br-stddev').value);
    const ror = parseFloat(document.getElementById('br-ror').value);
    const bb = parseFloat(document.getElementById('br-bb').value);
    if (!wr || wr <= 0 || !sd || !ror || !bb) return;
    // Required bankroll in bb: (sd^2 / (2*wr)) * ln(1/ror)
    const wrPerHand = wr / 100;
    const sdPerHand = sd / Math.sqrt(100);
    const requiredBB = (sd * sd / (2 * wr)) * Math.log(1 / ror);
    const requiredAmount = requiredBB * bb;
    const buyins = requiredBB / 100;
    document.getElementById('br-amount').textContent = '₱' + requiredAmount.toLocaleString('en-PH', {maximumFractionDigits: 0});
    document.getElementById('br-buyins').textContent = buyins.toFixed(1) + ' buy-ins (at 100bb)';
    document.getElementById('br-bbs').textContent = requiredBB.toLocaleString('en-PH', {maximumFractionDigits: 0}) + ' bb';
    document.getElementById('br-formula').textContent = 'σ²·ln(1/' + (ror * 100) + '%) / (2·WR)';
  }

  // ===== VARIANCE SIMULATOR =====
  function gaussian() {
    let u = 0, v = 0;
    while (u === 0) u = Math.random();
    while (v === 0) v = Math.random();
    return Math.sqrt(-2.0 * Math.log(u)) * Math.cos(2.0 * Math.PI * v);
  }
  function runVariance() {
    const hands = parseInt(document.getElementById('var-hands').value);
    const wr = parseFloat(document.getElementById('var-winrate').value);
    const sd = parseFloat(document.getElementById('var-stddev').value);
    if (!hands || hands < 100 || isNaN(wr) || !sd) return;

    const sims = 10000;
    const blocks = Math.floor(hands / 100);
    const meanPerBlock = wr;
    const sdPerBlock = sd / Math.sqrt(1);

    const results = [];
    let losingCount = 0;
    for (let i = 0; i < sims; i++) {
      let total = 0;
      for (let b = 0; b < blocks; b++) {
        total += meanPerBlock + sdPerBlock * gaussian();
      }
      results.push(total);
      if (total < 0) losingCount++;
    }
    results.sort((a, b) => a - b);

    const expected = wr * blocks;
    const risk = (losingCount / sims) * 100;

    document.getElementById('var-expected').textContent = (expected >= 0 ? '+' : '') + Math.round(expected).toLocaleString() + ' bb';
    document.getElementById('var-risk').textContent = risk.toFixed(1) + '%';

    // Distribution: percentiles
    const percentiles = [
      {p: 'Top 5%', v: results[Math.floor(sims * 0.95)], cls: 'green'},
      {p: 'Top 25%', v: results[Math.floor(sims * 0.75)], cls: 'green'},
      {p: 'Median', v: results[Math.floor(sims * 0.50)], cls: ''},
      {p: 'Bottom 25%', v: results[Math.floor(sims * 0.25)], cls: 'red'},
      {p: 'Bottom 5%', v: results[Math.floor(sims * 0.05)], cls: 'red'}
    ];
    const max = Math.max(Math.abs(results[0]), Math.abs(results[sims - 1]));
    const distHTML = percentiles.map(p => {
      const widthPct = Math.min(100, (Math.abs(p.v) / max) * 100);
      const sign = p.v >= 0 ? '+' : '';
      return `<div class="dist-row">
        <span class="dist-percentile">${p.p}</span>
        <span class="dist-bar ${p.cls}"><div style="width: ${widthPct}%"></div></span>
        <span class="dist-value">${sign}${Math.round(p.v).toLocaleString()} bb</span>
      </div>`;
    }).join('');
    document.getElementById('var-distribution').innerHTML = distHTML;
    document.getElementById('var-results').style.display = 'block';
  }

  // ===== KELLY =====
  function calcKelly() {
    const p = parseFloat(document.getElementById('kelly-prob').value) / 100;
    const odds = parseFloat(document.getElementById('kelly-odds').value);
    if (isNaN(p) || p <= 0 || p >= 1 || !odds || odds <= 1) {
      document.getElementById('kelly-full').textContent = '—';
      document.getElementById('kelly-half').textContent = '—';
      return;
    }
    const b = odds - 1;
    const q = 1 - p;
    const kelly = (b * p - q) / b;
    if (kelly <= 0) {
      document.getElementById('kelly-full').textContent = '0% — no edge';
      document.getElementById('kelly-half').textContent = '0% — pass';
      return;
    }
    document.getElementById('kelly-full').textContent = (kelly * 100).toFixed(1) + '%';
    document.getElementById('kelly-half').textContent = (kelly * 50).toFixed(1) + '%';
  }

  // ===== EFFECTIVE STACK =====
  function calcStack() {
    const hero = parseFloat(document.getElementById('es-hero').value);
    const villain = parseFloat(document.getElementById('es-villain').value);
    const bb = parseFloat(document.getElementById('es-bb').value);
    if (isNaN(hero) || isNaN(villain) || !bb) return;
    const eff = Math.min(hero, villain);
    const bbs = eff / bb;
    document.getElementById('es-eff').textContent = eff.toLocaleString();
    document.getElementById('es-context').textContent = hero <= villain ? 'You are the shorter stack' : 'Villain is the shorter stack';
    document.getElementById('es-bbs').textContent = bbs.toFixed(0) + ' bb';
    let depth = 'Standard cash depth';
    if (bbs < 25) depth = 'Short stack — push/fold range';
    else if (bbs < 50) depth = 'Medium stack — careful play';
    else if (bbs < 100) depth = 'Standard MTT depth';
    else if (bbs < 200) depth = 'Standard cash depth';
    else depth = 'Deep stack — maximize implied odds';
    document.getElementById('es-depth').textContent = depth;
  }

  // Run initial calcs
  calcPotOdds(); calcOuts(); calcROI(); calcBankroll(); calcKelly(); calcStack();
</script>

