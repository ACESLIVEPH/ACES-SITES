<script>
  // Placeholder signup handler — replace with your email provider integration.
  // Recommended: Beehiiv, Kit (formerly ConvertKit), Buttondown, or Mailchimp.
  function handleSignup(e) {
    e.preventDefault();
    const form = e.target;
    const email = form.querySelector('input[name=email]').value.trim();
    if (!email) return false;

    // TODO: replace with real provider endpoint, e.g.:
    //   fetch('https://api.beehiiv.com/v2/publications/PUB_ID/subscriptions', { ... })

    const button = form.querySelector('button');
    const originalText = button.innerHTML;
    button.innerHTML = 'Saved ✓';
    button.disabled = true;
    setTimeout(() => {
      form.reset();
      button.innerHTML = originalText;
      button.disabled = false;
    }, 2200);
    return false;
  }
</script>

